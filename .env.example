# ---------------------------------------------------------------------------
# AvtomaktabPlatforma — muhit o'zgaruvchilari namunasi
# Nusxalash:  copy .env.example .env   (keyin qiymatlarni to'ldiring)
# .env fayli gitignore qilinadi (hech qachon commit qilmang!).
# ---------------------------------------------------------------------------

# ---- Ilova (SQLite) ----
# SQLite fayli joylashuvi. Standart: data/avtomaktab.db (lokal) yoki
# /app/data/avtomaktab.db (Docker container ichida — o'zgartirish shart emas)
# AVTOMAKTAB_DB=

# Tinglash manzili va porti
HOST=0.0.0.0
PORT=8080

# Birinchi ishga tushirishda admin paroli.
# Bo'sh qoldirilsa demo parol ishlatiladi (admin123 — faqat sinov uchun!).
# PRODUCTION: kuchli parol qo'ying, masalan:
#   py -c "import secrets;print(secrets.token_urlsafe(18))"
ADMIN_INITIAL_PASSWORD=

# ---- MODUL 5: PAROLLARNI QAYTARIB OCHISH KALITI ----
# Talab: admin foydalanuvchilarning PAROLINI ko'ra (va o'zgartira) olsin.
# Parollar scrypt hash bilan saqlanadi (bir yo'nalishli) + shu kalit bilan
# AES-256-GCM shifrlangan IKKIINCHI nusxa (`users.password_enc`).
#
# BO'SH QOLDIRILSA — kalit birinchi ishga tushirishda avtomatik yaratiladi
# va shu yerga yoziladi. Qo'lda qo'yish shart emas.
#
# DIQQAT (xavfsizlik):
#   * Bu kalitni YO'QOTMANG — yo'qotsangiz barcha saqlangan parollar
#     qaytarib OCHILMAYDI (parolni qayta o'rnatish kerak bo'ladi).
#   * Kalit + bazaga kirish = barcha foydalanuvchi parollarini ko'rish.
#     Shu sababdan `.env` faylni zaxira nusxa bilan BIRGA saqlang va
#     hech qachon GitHub'ga yuklamang (`.gitignore`da turadi).
#   * Kalitni o'zgartirsangiz — eski parollar ko'rinmay qoladi.
# CREDENTIALS_KEY=

# ---- MODUL 4: XARITA (Yandex Maps JS API) ----
# Xarita endi OpenStreet emas — Yandex Maps. Kalitni shu yerga yozing
# (KODGA EMAS! `.env` `.gitignore`'da).
#
# Kalit olish: https://yandex.ru/dev/js/  ->  "Подключить API"
#   -> JS API -> API key -> "Create key"
#   -> Key beriladi. Ixtiyoriy: "Сайты для мгновенного запуска" ga platforma
#      domeningizni (localhost:8080) qo'shing — aks holda Yandex "403"
#      (calm down / unauthorized) xatosini beradi.
#
# DIQQAT: bu kalit BRAUZERDA ko'rinadi (frontend `GET /api/config` orqali
# oladi) — bu normal va xavfsiz: Yandex JS API kaliti ommaviy bo'lib,
# domain bo'yicha chegilanadi. Parol/token shu yo'l bilan hech qachon
# uzatilmaydi.
YANDEX_MAPS_API_KEY=

# Xarita markazi — STANDART: TOSHKENT.
# Boshqa shahar kerak bo'lsa, o'zgartiring (masalan Samarqand: 39.6542 / 66.9597)
MAP_CENTER_LAT=41.311081
MAP_CENTER_LNG=69.240562
# Dastlabki masshtab (11 = butun shahar, 15 = markaz, 17 = bino)
MAP_CENTER_ZOOM=12

# Xaritani butunlay o'chirish uchun: MAP_PROVIDER=none
# (sozlamalarda kenglik/uzunlik qo'lda kiritiladi, xarita chiqmaydi)
MAP_PROVIDER=yandex

# ---- Production (Docker) ----
# Hostdagi tashqi port (agar 8080 band bo'lsa)
APP_PORT=8080

# Kunlik avtomatik zaxiraning saqlash muddati (kunlarda)
BACKUP_RETENTION_DAYS=14

# (Ixtiyoriy) Zaxirani bulut xotiraga yuklash — rclone remote nomi
# Masalan: RCLONE_REMOTE=b2:avtomaktab-backups  (Backblaze B2)
# yoki:     RCLONE_REMOTE=s3:my-bucket/avtomaktab
RCLONE_REMOTE=

# ---- Telegram bot (aiogram 3) ----
# @BotFather (t.me/BotFather) orqali token oling:
#   /newbot  ->  nom va username ->  token beriladi
BOT_TOKEN=
# Bot adminlari — Telegram user_id, vergul bilan ajratiladi (masalan: 123456789,987654321)
# O'z user_id'ngizni bilish: t.me/userinfobot ga xabar yozing
# (eski nomi BOT_ADMINS ham qo'llab-quvvatlanadi, lekin ADMIN_IDS tavsiya etiladi)
ADMIN_IDS=
# Default til (uz / ru / en) — foydalanuvchi /start da tanlaydi, /lang bilan o'zgartiradi
BOT_DEFAULT_LANG=uz
# Bot SQLite bazasi (ixtiyoriy, default: data/bot.db)
# BOT_DB=data/bot.db

# ---- Platformani botga ulash ----
# Platforma domaini (masalan: https://avtomaktab.uz) — bot shu manzilni
# "🔗 Platformaga kirish" tugmasi va QR kod sifatida ishlatadi.
# Bo'sh qoldirilsa, platforma bot ro'yxatida ko'rinmaydi.
PLATFORM_NAME=Avtomaktab Platforma
PLATFORM_URL=

# ---- PostgreSQL (IXXTIYORIY — loyiha SQLite ishlatadi) ----
# Amaldagi backend SQLite. Postgres faqat `docker compose --profile db`
# orqali ixtiyoriy ishga tushiriladi (scriptlar/sqlite_to_postgres.py bilan
# o'tish mumkin). Hozircha buyruqlar quyidagi:
# POSTGRES_DB=avtomaktab
# POSTGRES_USER=avtomaktab
# POSTGRES_PASSWORD=
# POSTGRES_PORT=5432