# ============================================================================
# AvtomaktabPlatforma — .gitignore
# Muhim: .env va baza fayllari HECH QACHON GitHub'ga yuklanmasligi kerak!
# ============================================================================

# ---- Muhit o'zgaruvchilari (parollar, kalitlar — commit qilma!) ----
.env
.env.local
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- Node.js ----
node_modules/

# ---- Baza va zaxira (lokal ma'lumotlar) ----
data/*.db
data/*.db-wal
data/*.db-shm
data/backups/
backups/
# Bot bazalari (asosiy platforma bazasi bilan aralashmasligi uchun)
bot/data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# ---- Telegram bot (maksfiy fayllar) ----
# Botning o'z .env fayli (umumiy `.env` qoidasi ham qamrab oladi — qo'shimcha
# qat'iy qoida, agar kodingiz boshqa papkada ham bo'lsa)
bot/.env

# ---- IDE / tahrirlovchilar ----
.idea/
.vscode/
*.iml
*.swp

# ---- Operatsion tizim ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Loglar ----
*.log

# ---- QA skrinshotlar (m*shot*.png, shots/) — talab emas kodga ----
m*shot*.png
shots/

# ---- Yaqin atrofdagi test artefaktlari ----
.tox/
.coverage
htmlcov/