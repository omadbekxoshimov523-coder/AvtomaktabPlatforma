# ============================================================================
# AVTOMAKTAB Telegram boti — namuna konfiguratsiya
#
# ⚠️ HAQIQIY QIYMATLARNI SHU FAYLGA EMAS, `.env` FAYLGA YOZING.
#    `.env` .gitignore'da — GitHub'ga hech qachon yuklanmaydi.
#    (python-dotenv avtomatik .env ni o'qiydi; `.env` ni nusxalash:
#     Windows:  copy .env.example .env
#     Linux/mac: cp .env.example .env )
# ============================================================================

# ---- BotFather dan olingan token (SHART) ----
# Telegram'da: @BotFather → /newbot → nom va username → token beriladi
# Namuna shakli: 123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_TOKEN=

# ---- Admin Telegram ID'lari (vergul bilan) ----
# Faqat shu ID'ga ega foydalanuvchilar /add_school, /list_schools,
# /edit_school, /remove_school, /stats, /qr buyruqlarini ishlatishi mumkin.
# O'z user_id'ngizni olish: Telegram'da @userinfobot ga xabar yozing.
# Namuna: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# ---- Platformani botga ulash ----
# Asosiy platformaning ommaviy manzili (login sahifasi). Bot /start dagi
# "🔗 Platformaga kirish" tugmasi shu URL ga olib boradi, /qr esa shundan
# QR kod yasaydi. Platforma hali joylashtirilmagan bo'lsa — bo'sh qoldiring.
PLATFORM_NAME=Avtomaktab Platforma
PLATFORM_URL=

# ---- Default til: uz | ru | en ----
# Foydalanuvchi birinchi /start da til tanlaydi, keyin /lang bilan
# o'zgartiradi. Bu qiymat faqat birinchi tanlov uchun ko'rsatiladi.
BOT_DEFAULT_LANG=uz

# ---- SQLite bazasi yo'li (ixtiyoriy) ----
# Loyiha ildiziga nisbatan. Docker'da /app/data/bot.db (volume bot-data).
# BOT_DB=data/bot.db

# ---- Botga xabar yuborish uchun qulaylik (ixtiyoriy) ----
# Botning o'z logini (README da ko'rsatiladi):
# BOT_NAME=
# BOT_USERNAME=
